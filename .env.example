# ─────────────────────────────────────────────────────────────
# Moxie Ops — environment variables
# Copy to .env.local and fill in. lib/env.ts validates these on boot.
# ─────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/moxie_ops?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Anthropic
ANTHROPIC_API_KEY=

# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# Google Sheets
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
INVENTORY_SPREADSHEET_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="ops@moxiebeauty.in"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
OPS_WHATSAPP_GROUP=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="ap-south-1"
S3_BUCKET_NAME=

# Warehouse
WAREHOUSE_EMAIL="warehouse@moxiebeauty.in"

# ── Blinkit / partnersbiz live scraping (primary data source) ──
# REQUIRED: just your partnersbiz login email + the GMAIL_* OAuth above (to read the OTP).
BLINKIT_LOGIN_EMAIL=                # partnersbiz account email (OTP is emailed here)
BLINKIT_START_DATE="2026-06-01"     # backfill floor — POs from this date onward
BLINKIT_BASE_URL="https://partnersbiz.com"
# Background auto-sync (runs while the app is up — no external cron needed)
BLINKIT_AUTO_SYNC="true"            # "false" to disable
BLINKIT_SYNC_INTERVAL_HOURS="3"     # how often to re-scrape
# OPTIONAL — leave blank. No private API key is needed; entity info is auto-derived
# from the login response. Only set these if the report API rejects requests and you
# capture the exact header values from your browser's network tab.
BLINKIT_API_KEY=                    # optional x-api-key (public web constant, usually unneeded)
BLINKIT_ENTITY_ID=                  # optional x-entity-id override
BLINKIT_ENTITY_TYPE=                # optional x-entity-type override

# Manual fallback: folder to read a dropped CSV/XLSX dump from (optional).
BLINKIT_DOWNLOAD_DIR=

# ── Zepto / partner.zepto.co.in live scraping (mirrors the Blinkit block) ──
# REQUIRED to log in: the Zepto portal account email + password (MFA via emailed OTP).
ZEPTO_LOGIN_EMAIL=                  # Zepto portal account email (the OTP is sent for this user)
ZEPTO_PASSWORD=                     # Zepto portal password (sign-in body) — NEVER commit
ZEPTO_START_DATE="2026-06-01"       # backfill floor — POs from this date onward
ZEPTO_BASE_URL="https://cx.zepto.co.in"
ZEPTO_APPLICATION_ID="59b80e60-05bd-45c2-a334-d5ae76c2bb32"  # public web constant
# Background auto-sync (runs while the app is up — no external cron needed)
ZEPTO_AUTO_SYNC="true"              # "false" to disable
ZEPTO_SYNC_INTERVAL_HOURS="3"       # how often to re-scrape
# OTP inbox over IMAP (Gmail app password) — the inbox that receives the Zepto OTP.
ZEPTO_OTP_EMAIL=amritya@moxiebeauty.in   # monitored inbox; defaults to ZEPTO_LOGIN_EMAIL
ZEPTO_OTP_APP_PASSWORD=             # Gmail app password for ZEPTO_OTP_EMAIL (strip spaces)
# PO-grid data endpoint — set once the logged-in portal's XHR is captured (Copy as cURL).
# May be a FULL URL on a host different from ZEPTO_BASE_URL — the data API lives on
# fcc.zepto.co.in, not the auth host cx.zepto.co.in. Supports {since}/{until}/{page}/{pageSize}.
ZEPTO_PO_LIST_PATH=                 # e.g. https://fcc.zepto.co.in/api/v1/po/filter
ZEPTO_PO_LIST_METHOD="GET"          # set "POST" for fcc.zepto.co.in/api/v1/po/filter
# Exact POST body from the captured cURL. Placeholders {since}/{until}/{page}/{pageSize}/{offset}.
ZEPTO_PO_LIST_BODY=                 # e.g. {"filters":{"from":"{since}","to":"{until}"},"page":"{page}","pageSize":"{pageSize}"}
ZEPTO_PORTAL_COOKIE=                # optional raw Cookie header if the data host needs a session cookie
ZEPTO_PO_DETAIL_PATH=              # optional per-PO line items, e.g. /api/v1/po/{poId}/items

# ── Swiggy Instamart Ads Portal live scraping (mirrors the Blinkit block) ──
# OTP-only login: a verification code is emailed to INSTAMART_LOGIN_EMAIL (must be the monitored inbox).
INSTAMART_LOGIN_EMAIL=              # Swiggy seller-portal account email; OTP arrives here
INSTAMART_OTP_EMAIL=                # monitored inbox; defaults to INSTAMART_LOGIN_EMAIL
INSTAMART_OTP_APP_PASSWORD=         # Gmail app password for the OTP inbox (falls back to BLINKIT_OTP_APP_PASSWORD)
INSTAMART_START_DATE="2026-06-01"   # backfill floor
INSTAMART_AUTO_SYNC="true"          # "false" to disable
INSTAMART_SYNC_INTERVAL_HOURS="3"
INSTAMART_MANUFACTURER_FILTER=      # only ingest POs whose brand contains this (empty = all)
# PO-grid data endpoint — set once the logged-in portal's XHR is captured (Copy as cURL).
# May be a FULL URL on a host different from INSTAMART_API_BASE_URL — the PO search lives on
# picker.swiggy.com, NOT partner.swiggy.com.
INSTAMART_PO_LIST_PATH=             # e.g. https://picker.swiggy.com/api/v1/searchPurchaseOrder
INSTAMART_PO_LIST_METHOD="GET"      # set "POST" for picker.swiggy.com/searchPurchaseOrder
INSTAMART_PO_LIST_BODY=             # exact POST body; placeholders {since}/{until}/{page}/{pageSize}/{offset}
# picker.swiggy.com authorizes off the portal SESSION cookie (it rejects the ozone IDP Bearer
# token with "Token missing"), so paste the captured cURL's Cookie header here.
INSTAMART_PORTAL_COOKIE=
INSTAMART_PO_DETAIL_PATH=           # optional per-PO line items (use {poNo} placeholder)

# ── Test PO email (Gmail SMTP, from amritya@moxiebeauty.in) ──
# Same Gmail app password as BLINKIT_OTP_APP_PASSWORD — strip spaces when entering.
PO_TEST_EMAIL_SMTP_USER="amritya@moxiebeauty.in"
PO_TEST_EMAIL_SMTP_PASS=             # Gmail app password (16 chars, strip spaces)
PO_TEST_EMAIL_TO="abhishek@moxiebeauty.in"

# ── PO allocation email reference number ──
# Subject of every allocation email: `${PO_EMAIL_REF_PREFIX}${n}` (e.g. "MB - 26/27 - 1457").
# The counter starts from PO_EMAIL_REF_START and auto-increments in the DB on each send.
# No migration needed — counter is stored in the IntegrationToken table.
PO_EMAIL_REF_PREFIX="MB - 26/27 - "  # prefix including trailing space
PO_EMAIL_REF_START=1457               # first reference number to assign

# Company (used on invoices / debit notes)
COMPANY_NAME="Moxie Beauty Pvt Ltd"
COMPANY_GSTIN="29ABCDE1234F1Z5"
COMPANY_ADDRESS="No. 4, Brigade Road, Bengaluru, Karnataka 560001"
COMPANY_BANK_ACCOUNT_NAME="Moxie Beauty Pvt Ltd"
COMPANY_BANK_ACCOUNT_NO="000123456789"
COMPANY_BANK_IFSC="HDFC0000123"
COMPANY_BANK_NAME="HDFC Bank"

# Portal scraping credentials (referenced by Channel.portalPasswordEnvVar)
INSTAMART_PORTAL_PASSWORD=

# Cron security
CRON_SECRET=
