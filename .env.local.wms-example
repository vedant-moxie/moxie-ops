# WMS Integration (Benchmark Computer Solutions / myrgl.com)

# Portal API (behind wms.myrgl.com) — used to pull the Consolidated Stock
# report for per-warehouse free saleable stock. Same login as the portal UI.
WMS_PORTAL_BASE_URL=https://wms-api.myrgl.com
WMS_EMAIL=your-wms-email@example.com
WMS_PASSWORD=your-wms-password
# Stock mirror older than this many minutes re-syncs on read (and via cron)
WMS_STOCK_STALE_MINUTES=15

# External (documented) API — used to push sales orders that block stock in
# the WMS. Remove "uat" from the URL when going live (per WMS doc note).
WMS_BASE_URL=https://wms-uat-api.myrgl.com

# Channel → WMS party codes (from the WMS customer master)
WMS_PARTY_CODES={"Blinkit":"2572580000370297644","Zepto":"YOUR_ZEPTO_CODE","Instamart":"YOUR_IM_CODE","Nykaa":"YOUR_NYKAA_CODE"}
WMS_DEFAULT_PARTY_CODE=MOXIE001

# Warehouse registry (codes, GSTINs, WMS names) lives in lib/warehouses.ts —
# no env needed; edit that file to add a warehouse.
