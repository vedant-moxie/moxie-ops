# WMS Integration (Benchmark Computer Solutions / myrgl.com)

# Portal API (behind wms.myrgl.com) — used to pull the Consolidated Stock
# report for per-warehouse free saleable stock. Same login as the portal UI.
WMS_PORTAL_BASE_URL=https://wms-api.myrgl.com
WMS_EMAIL=your-wms-email@example.com
WMS_PASSWORD=your-wms-password
# Stock mirror older than this many minutes re-syncs on read (and via cron)
WMS_STOCK_STALE_MINUTES=15

# External (documented) API — used to push sales orders that block stock in
# the WMS. Remove "uat" from the URL when going live (per WMS doc note).
WMS_BASE_URL=https://wms-uat-api.myrgl.com

# Channel → WMS party codes (from the WMS customer master)
WMS_PARTY_CODES={"Blinkit":"2572580000370297644","Zepto":"YOUR_ZEPTO_CODE","Instamart":"YOUR_IM_CODE","Nykaa":"YOUR_NYKAA_CODE"}
WMS_DEFAULT_PARTY_CODE=MOXIE001

# Warehouse registry (codes, GSTINs, WMS names) lives in lib/warehouses.ts —
# no env needed; edit that file to add a warehouse.

# ── SO Entry Check (plan 008) ───────────────────────────────────────────────
# Sales orders are read with WMS_EMAIL/WMS_PASSWORD above — nothing extra to configure.
# Two complementary sources:
#   • hourly  — dashboard KPI feed (analytics/dashboard/kpi/list), all warehouses, no
#     writes. Gives SO number, one reference, party and dates → catches missing SOs,
#     untraceable references and late punches.
#   • daily   — Outward LOI Report (388), which adds both PO numbers, SKU code and SKU
#     quantity → the SKU-wise quantity match. It only lists DISPATCHED orders, and its
#     warehouse parameter is disabled, so the fetch switches the account's selected
#     warehouse per warehouse and restores it afterwards (the one write we make).
#
# Set WMS_SO_REPORT_NAME only if RGL ever ships a purpose-built salesorder report with
# lines; it then replaces the Outward LOI source. Normally leave it unset.
# WMS_SO_REPORT_NAME=
# WMS_SO_REPORT_ID=0
# WMS_SO_REPORT_SP=
SO_MISSING_SLA_HOURS=24       # hours after approval before "Missing SO" is flagged
SO_CHECK_WINDOW_DAYS=30       # rolling window of approved POs checked
SO_LINES_WINDOW_DAYS=7        # window for the daily quantity pass (one report per warehouse)
SO_CHECK_AUTO=true            # "false" to disable the background run
SO_CHECK_INTERVAL_HOURS=1     # hourly 09:00–21:00 IST; the 20:00 IST run also pulls quantities
