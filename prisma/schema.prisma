// Moxie Beauty — D2C Operations Management System
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Channel {
  id                   String   @id @default(cuid())
  name                 String
  emailDomain          String   @unique // nykaa.com
  poSenderEmail        String? // specific PO sender address
  grnSenderEmail       String?
  tier                 String   @default("B") // A, B, C
  fillRateCommitment   Float    @default(90.0) // % minimum fill
  deliverySlaHours     Int      @default(48)
  billingGstin         String?
  billingAddress       String?
  logoColor            String? // brand accent for the UI chip
  portalUrl            String?
  portalUsername       String?
  portalPasswordEnvVar String? // name of env var holding password
  grnViaEmail          Boolean  @default(true)
  grnViaPortal         Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  channelSkus    ChannelSku[]
}

model Sku {
  id           String   @id @default(cuid())
  internalCode String   @unique
  name         String
  category     String?
  hsnCode      String?
  gstRate      Float    @default(18.0)
  uom          String   @default("unit")
  casePackSize Int      @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  channelSkus        ChannelSku[]
  poLineItems        PoLineItem[]
  dispatchLineItems  DispatchLineItem[]
  grnLineItems       GrnLineItem[]
  discrepancies      Discrepancy[]
  inventorySnapshots InventorySnapshot[]
  itemMapping        SkuItemMapping?
}

/// Editable SKU master — the single source of truth for channel-SKU mappings and
/// per-channel taxable values (Settings → SKUs, admin-only). Mirrors the columns of
/// the "SKU Master" workbook so it round-trips to/from xlsx/csv. Read through
/// lib/services/sku-master.ts, which caches it and powers SKU resolution + the
/// allocation price-mismatch gate. `gstRate` is a fraction (0.05 = 5%) as in the sheet.
model SkuMaster {
  id           String  @id @default(cuid())
  internalCode String  @unique // "GCS200" — our SKU id, the key linking every channel
  name         String? // product name (kept in sync with Sku.name when available)
  hsnCode      String?
  gstRate      Float   @default(0)
  mrp          Float? // New MRP
  taxableB2B   Float? // New Taxable Value for B2B

  // Channel SKU codes (how our id links to each platform)
  zeptoCode     String?
  nykaaCode     String?
  instamartCode String?
  blinkitCode   String?
  // Tira: the SAP "Tira Code (SAP)" (e.g. "494619783") that appears as productCode
  // on Tira PO lines. ean is the universal barcode (Moxie GS1 prefix 890617003…).
  tiraCode      String?
  ean           String?
  // Standard-platform listing IDs from the Beauty Comm "Product Master" sheet.
  // *Code columns are the platform's own listing SKU; *Pids are the numeric
  // product IDs that appear on those platforms' PO/catalog rows.
  myntraCode    String? // Myntra style/listing code, e.g. "33509564"
  purplleCode   String? // Purplle listing code, e.g. "PPLB8906170030002"
  nykaaPids     String? // Nykaa product ID(s), e.g. "16853282"
  purpllePids   String? // Purplle product ID(s), e.g. "409741"

  // Per-channel expected unit taxable value (excl. GST)
  taxableZepto     Float?
  taxableNykaa     Float?
  taxableInstamart Float?
  taxableMyntra    Float?
  taxableBlinkit   Float?
  taxableReliance  Float?
  taxableAmazonNow Float?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blinkitCode])
  @@index([zeptoCode])
  @@index([nykaaCode])
  @@index([instamartCode])
  @@index([tiraCode])
  @@index([myntraCode])
  @@index([purplleCode])
}

model ChannelSku {
  id             String  @id @default(cuid())
  channelId      String
  skuId          String
  channelSkuCode String // e.g. NKA-0124
  channelMoq     Int     @default(1)
  unitPrice      Float?

  channel Channel @relation(fields: [channelId], references: [id])
  sku     Sku     @relation(fields: [skuId], references: [id])

  @@unique([channelId, channelSkuCode])
  @@index([skuId])
}

model PurchaseOrder {
  id                    String    @id @default(cuid())
  channelId             String
  channelPoNumber       String?
  gmailMessageId        String?   @unique // idempotency key (email source)
  externalId            String?   @unique // idempotency key (channel imports, e.g. "blinkit:<poNo>")
  source                String    @default("EMAIL") // EMAIL | BLINKIT | NYKAA | PORTAL | MANUAL
  status                PoStatus  @default(PENDING_REVIEW)
  priority              String? // P1, P2, P3
  priorityScore         Int? // computed by AI (1-100)
  priorityRationale     String?
  poDate                DateTime?
  requestedDeliveryDate DateTime?
  totalRequestedValue   Float?
  opsNotes              String?
  approvedBy            String?
  approvedAt            DateTime?
  // PO-preparation email reference (e.g. "MB - 26/27 - 1458") issued from the Counter
  // series on the FIRST send attempt (send, hold, or failure) and reused verbatim on
  // every resend, so the reference stays bound to the PO. Null until the first attempt.
  emailRef              String?
  emailSentAt           DateTime?
  // Delivery state of the PO-preparation email so undelivered POs surface for resend
  // instead of silently misrouting:
  //   NOT_SENT — no attempt yet
  //   SENT     — delivered to ≥1 real recipient
  //   HELD     — withheld because no recipients resolved (needs recipient fix + resend)
  //   FAILED   — transport failed after retries (needs resend)
  emailStatus           String    @default("NOT_SENT")
  // Human-readable reason when emailStatus is HELD/FAILED (shown in the resend preview).
  emailHoldReason       String?
  // Multi-user allocation lock: who is currently working this PO. Acquired when a
  // user opens it to allocate; released on send / cancel / TTL expiry. The atomic
  // claim check at allocation time is what prevents two people double-allocating.
  claimedById           String?
  claimedByLabel        String?
  claimedAt             DateTime?
  rawEmailBody          String?   @db.Text
  rawEmailSubject       String?
  rawData               Json? // full original source fields (e.g. all Blinkit PO columns)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  channel              Channel               @relation(fields: [channelId], references: [id])
  lineItems            PoLineItem[]
  warehouseInstruction WarehouseInstruction?
  dispatchRecord       DispatchRecord?
  deliveryRecord       DeliveryRecord?
  grnRecord            GrnRecord?
  invoice              Invoice?

  @@index([channelId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([claimedById])
}

/// Atomic named counters (e.g. the PO email reference series "MB - 26/27 - 1457").
/// `value` is incremented in a single UPDATE … RETURNING so concurrent allocators
/// never get duplicate numbers. `prefix` is the editable series prefix.
model Counter {
  key       String   @id // e.g. "po_email_ref"
  prefix    String   @default("")
  value     Int      @default(0)
  // Zero-pad width for the rendered number: 0 = no padding, 4 = "0001". The number
  // never truncates — once it exceeds the width it just prints in full.
  padWidth  Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum PoStatus {
  PENDING_REVIEW
  PRIORITISED
  ALLOCATED
  APPROVED
  DISPATCHED
  DELIVERED
  GRN_RECEIVED
  CLOSED
  DISCREPANCY
  ON_HOLD
}

model PoLineItem {
  id             String  @id @default(cuid())
  poId           String
  skuId          String
  channelSkuCode String?
  requestedQty   Int
  approvedQty    Int?
  unitPrice      Float?
  rawData        Json? // full original source row fields

  po  PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku Sku           @relation(fields: [skuId], references: [id])

  @@index([poId])
  @@index([skuId])
}

model InventorySnapshot {
  id          String   @id @default(cuid())
  skuId       String
  onHandQty   Int
  reservedQty Int      @default(0)
  safetyStock Int      @default(0)
  atpQty      Int // computed: onHand - reserved - safety
  snapshotAt  DateTime @default(now())

  sku Sku @relation(fields: [skuId], references: [id])

  @@index([skuId, snapshotAt])
}

/// AI-resolved mapping from an unmapped Sku (internalCode = raw channel item ID)
/// to the correct WMS warehouse SKU code. Written by the AI mapper on first allocation
/// open; high-confidence mappings are auto-confirmed, low-confidence ones are flagged
/// for human review in the "Review Mappings" step on the allocation page.
model SkuItemMapping {
  id             String    @id @default(cuid())
  skuId          String    @unique
  wmsCode        String    // WMS WarehouseStock.skuCode, e.g. "HRHM100"
  wmsDescription String?   // best-guess description for display
  confidence     Float     // 0–1 from the AI model
  method         String    @default("ai") // "ai" | "manual"
  needsReview    Boolean   @default(false) // true when confidence < 0.85
  confirmedAt    DateTime? // set when user confirms (or auto-confirmed when confidence ≥ 0.85)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sku Sku @relation(fields: [skuId], references: [id])

  @@index([wmsCode])
  @@index([needsReview])
}

/// Live per-warehouse saleable stock mirrored from the WMS Consolidated Stock
/// report. `wmsFreeQty` is the free-available figure from the last sync;
/// `freeQty` starts equal to it and is decremented locally on each allocation
/// so back-to-back POs see shrinking availability until the next sync
/// (when the WMS's own salesorder-lock takes over) re-baselines it.
model WarehouseStock {
  id            String   @id @default(cuid())
  warehouseCode String // registry code: NCR | BLR | MUM (lib/warehouses.ts)
  skuCode       String // master SKU code as in WMS (e.g. "CAHHO100")
  totalQty      Int      @default(0) // saleable quantity in WMS
  lockedQty     Int      @default(0) // salesorder + picking locked in WMS
  wmsFreeQty    Int      @default(0) // free available per last WMS sync
  freeQty       Int      @default(0) // wmsFreeQty minus local allocations since sync
  syncedAt      DateTime
  updatedAt     DateTime @updatedAt

  @@unique([warehouseCode, skuCode])
  @@index([skuCode])
}

model WarehouseInstruction {
  id              String    @id @default(cuid())
  poId            String    @unique
  sentAt          DateTime?
  sentToEmail     String
  resendMessageId String?
  emailSubject    String?
  emailBody       String?   @db.Text
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())

  po             PurchaseOrder   @relation(fields: [poId], references: [id])
  dispatchRecord DispatchRecord?
}

model DispatchRecord {
  id                     String    @id @default(cuid())
  poId                   String    @unique
  warehouseInstructionId String?   @unique
  gmailMessageId         String?   @unique
  awbNumber              String?
  carrierName            String?
  dispatchedAt           DateTime?
  estimatedDeliveryDate  DateTime?
  rawEmailBody           String?   @db.Text
  createdAt              DateTime  @default(now())

  po                   PurchaseOrder         @relation(fields: [poId], references: [id])
  warehouseInstruction WarehouseInstruction? @relation(fields: [warehouseInstructionId], references: [id])
  lineItems            DispatchLineItem[]
  deliveryRecord       DeliveryRecord?
}

model DispatchLineItem {
  id               String @id @default(cuid())
  dispatchRecordId String
  skuId            String
  dispatchedQty    Int

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)
  sku            Sku            @relation(fields: [skuId], references: [id])

  @@index([dispatchRecordId])
}

model DeliveryRecord {
  id                String    @id @default(cuid())
  poId              String    @unique
  dispatchRecordId  String    @unique
  gmailMessageId    String?   @unique
  deliveredAt       DateTime?
  deliveryStatus    String?
  grnReminderSentAt DateTime?
  grnDeadline       DateTime? // deliveredAt + 48h
  createdAt         DateTime  @default(now())

  po             PurchaseOrder  @relation(fields: [poId], references: [id])
  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id])
}

model GrnRecord {
  id                 String    @id @default(cuid())
  poId               String    @unique
  source             GrnSource
  gmailMessageId     String?   @unique
  channelGrnNumber   String?
  receivedAt         DateTime  @default(now())
  status             GrnStatus @default(PENDING_RECONCILIATION)
  reconciledAt       DateTime?
  reconciledBy       String?
  totalAcceptedValue Float?
  rawData            String?   @db.Text
  createdAt          DateTime  @default(now())

  po            PurchaseOrder @relation(fields: [poId], references: [id])
  lineItems     GrnLineItem[]
  discrepancies Discrepancy[]
  invoice       Invoice?
}

enum GrnSource {
  EMAIL
  PORTAL
  MANUAL_CSV
}

enum GrnStatus {
  PENDING_RECONCILIATION
  ACCEPTED
  DISCREPANCY_FLAGGED
  RESOLVED
}

model GrnLineItem {
  id              String  @id @default(cuid())
  grnId           String
  skuId           String
  receivedQty     Int
  rejectedQty     Int     @default(0)
  rejectionReason String?

  grn GrnRecord @relation(fields: [grnId], references: [id], onDelete: Cascade)
  sku Sku       @relation(fields: [skuId], references: [id])

  @@index([grnId])
}

model Discrepancy {
  id              String            @id @default(cuid())
  poId            String
  grnId           String
  skuId           String
  dispatchedQty   Int
  receivedQty     Int
  varianceQty     Int // dispatchedQty - receivedQty
  variancePct     Float
  status          DiscrepancyStatus @default(OPEN)
  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())

  grnRecord GrnRecord @relation(fields: [grnId], references: [id])
  sku       Sku       @relation(fields: [skuId], references: [id])

  @@index([grnId])
  @@index([status])
}

enum DiscrepancyStatus {
  OPEN
  ACCEPTED
  DEBIT_NOTE_RAISED
  DISPUTED
  RESOLVED
}

model Invoice {
  id            String    @id @default(cuid())
  poId          String    @unique
  grnId         String    @unique
  invoiceNumber String    @unique
  invoiceDate   DateTime
  totalAmount   Float
  gstAmount     Float
  s3Key         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  po  PurchaseOrder @relation(fields: [poId], references: [id])
  grn GrnRecord     @relation(fields: [grnId], references: [id])
}

model IntegrationToken {
  provider     String   @id // e.g. "blinkit"
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  data         Json?
  savedAt      DateTime @default(now()) @updatedAt
}

model ProcessedEmail {
  gmailMessageId String   @id
  emailType      String // po_received | dispatch_confirmation | grn_email | delivery_confirmation
  processedAt    DateTime @default(now())
  poId           String?
  result         Json?
}

/// Generic immutable audit trail. `entityId` is a free-form key (a PO id, a
/// channel id, a SkuMaster internalCode, …) interpreted with `entityType` — no
/// FK, so any entity can be audited. PO history is read via
/// (entityType="PurchaseOrder", entityId=poId).
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  performedBy String?
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
